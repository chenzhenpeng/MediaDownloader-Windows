+def direct_video_url(*candidates):
+    """Prefer a whole-file URL to an HLS/DASH playlist; never use one HLS segment."""
+    urls = []
+    for value in candidates:
+        if isinstance(value, str):
+            urls.append(value)
+        elif isinstance(value, list):
+            urls.extend(item.get("url") if isinstance(item, dict) else item for item in value)
+        elif isinstance(value, dict):
+            urls.append(value.get("url"))
+    for url in urls:
+        if not isinstance(url, str) or not url.startswith(("https://", "http://")):
+            continue
+        if not urlparse(url).path.lower().endswith((".m3u8", ".mpd", ".ts", ".m4s")):
+            return url
+    return next((url for url in urls if isinstance(url, str) and url.startswith(("https://", "http://"))
+                 and not urlparse(url).path.lower().endswith((".ts", ".m4s"))), None)
+
